# 1. Convex Cloud URL (created automatically when you run `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# 2. Optional Email Notifications via Resend (https://resend.com - 3,000 free emails/mo)
# Can be placed in .env.local / Netlify Env Vars OR in Convex Dashboard Environment Variables
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="Clodagh Beresford Dunne Website <onboarding@resend.dev>"


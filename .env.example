# 1. Convex Cloud URL (created automatically when you run `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://festive-mockingbird-572.eu-west-1.convex.cloud

# 2. Optional Email Notifications via Resend (https://resend.com - 3,000 free emails/mo)
# Can be placed in .env.local / Netlify Env Vars OR in Convex Dashboard Environment Variables
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="Clodagh Beresford Dunne Website <clodaghberesford@yahoo.com>"

# 3. PayPal Checkout Configuration
# Standard Checkout works out-of-the-box using Clodagh's PayPal receiver email:
NEXT_PUBLIC_PAYPAL_BUSINESS_EMAIL=clodaghberesford@yahoo.com

# Optional: Add PayPal Developer REST API credentials (https://developer.paypal.com)
# to enable inline PayPal Smart Payment Buttons + inline Debit/Credit Card fields:
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# 4. Admin Login Credentials (/admin)
ADMIN_EMAIL=clodaghberesford@yahoo.com
ADMIN_PASSWORD=ColliganPoet2026!



